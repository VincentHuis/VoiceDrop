    <string name="onboarding_next">Siguiente</string>
    <string name="onboarding_done">Listo</string>
    <string name="onboarding_page1_title">Dicta, y listo</string>
    <string name="onboarding_page1_body">Dicta una nota con el mosaico de tu reloj o toca el botón de micrófono en la app. La nota se reconoce y procesa automáticamente.</string>
    <string name="onboarding_page2_title">Ordenado automáticamente</string>
    <string name="onboarding_page2_body">Empieza con una palabra clave y la app sabe de qué se trata. «Compras leche» va a tu lista de compras. «Recordatorio mañana dentista» programa un recordatorio.</string>
    <string name="onboarding_page3_title">Recordatorio a tiempo o en lugar</string>
    <string name="onboarding_page3_body">La app puede recordarte a una hora determinada o cuando llegues a algún lugar — en casa, en el trabajo o en el supermercado. Tu lista de compras aparece automáticamente al entrar en un supermercado. Se necesitan algunos permisos.</string>
    <string name="onboarding_perm_location">Ubicación</string>
    <string name="onboarding_perm_location_desc">Para recordatorios basados en la ubicación y la notificación de compras al llegar al supermercado.</string>
    <string name="onboarding_perm_location_denied">Los recordatorios de ubicación y las notificaciones de compras no funcionarán.</string>
    <string name="onboarding_perm_notif">Notificaciones</string>
    <string name="onboarding_perm_notif_desc">Para todos los recordatorios y notificaciones de compras.</string>
    <string name="onboarding_perm_notif_denied">No recibirás ninguna notificación de la app.</string>
    <string name="onboarding_perm_calendar">Calendario</string>
    <string name="onboarding_perm_calendar_desc">Para añadir citas directamente a Google Calendar.</string>
    <string name="onboarding_perm_calendar_denied">Las entradas del calendario no se guardarán automáticamente.</string>
