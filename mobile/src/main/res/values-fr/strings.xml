    <string name="onboarding_page1_title">Dictez, c\'est fait</string>
    <string name="onboarding_page1_body">Dictez une note via la vignette de votre montre ou appuyez sur le bouton micro dans l\'application. La note est reconnue et traitée automatiquement.</string>
    <string name="onboarding_page2_title">Trié automatiquement</string>
    <string name="onboarding_page2_body">Commencez par un mot-clé et l\'appli sait de quoi il s\'agit. « Courses lait » va dans votre liste de courses. « Rappel demain dentiste » planifie un rappel.</string>
    <string name="onboarding_page3_title">Rappel à l\'heure ou au lieu</string>
    <string name="onboarding_page3_body">L\'appli peut vous rappeler à une heure précise ou à votre arrivée quelque part — à la maison, au travail ou au supermarché. Votre liste de courses apparaît automatiquement à l\'entrée d\'un supermarché. Quelques autorisations sont nécessaires.</string>
    <string name="onboarding_perm_location">Localisation</string>
    <string name="onboarding_perm_location_desc">Pour les rappels basés sur la localisation et la notification de courses à l\'arrivée au supermarché.</string>
    <string name="onboarding_perm_location_denied">Les rappels de localisation et les notifications de courses ne fonctionneront pas.</string>
    <string name="onboarding_perm_notif">Notifications</string>
    <string name="onboarding_perm_notif_desc">Pour tous les rappels et les notifications de courses.</string>
    <string name="onboarding_perm_notif_denied">Vous ne recevrez aucune notification de l\'application.</string>
    <string name="onboarding_perm_calendar">Agenda</string>
    <string name="onboarding_perm_calendar_desc">Pour ajouter des rendez-vous directement dans Google Agenda.</string>
    <string name="onboarding_perm_calendar_denied">Les entrées d\'agenda ne seront pas enregistrées automatiquement.</string>
