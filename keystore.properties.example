# Template voor keystore.properties (de echte file staat in .gitignore).
# Kopieer naar keystore.properties en vul de echte waarden in, of laat
# `keytool` 'm genereren. Zonder deze file bouwt de release-build ongetekend.
storeFile=keystore/upload-keystore.jks
storePassword=JOUW_STORE_WACHTWOORD
keyAlias=voicedrop-upload
keyPassword=JOUW_KEY_WACHTWOORD
